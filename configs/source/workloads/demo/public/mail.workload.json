    },
    {
      "op": "copy",
      "from": "/context/storage/nfs_exports/0/path",
      "path": "/cluster_resources/0/spec/local/path"
    },
    {
      "op": "copy",
      "from": "/context/namespace",
      "path": "/cluster_resources/0/spec/claimRef/namespace"
    },
    {
      "op": "copy",
      "from": "/context/id",
      "path": "/cluster_resources/0/spec/nodeAffinity/required/nodeSelectorTerms/0/matchExpressions/0/values/0"
    },
    {
      "op": "copy",
      "from": "/context/address",
      "path": "/resources/2/spec/externalIPs/0"
    },
    {
      "op": "copy",
      "from": "/context/node_selector",
      "path": "/resources/3/spec/template/spec/nodeSelector"
    },
    {
      "op": "copy",
