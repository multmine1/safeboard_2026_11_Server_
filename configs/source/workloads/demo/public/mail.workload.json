      "path": "/resources/3/spec/template/spec/containers/0/image"
    },
    {
      "op": "copy",
      "from": "/context/compute/main/containers/mail",
      "path": "/resources/3/spec/template/spec/containers/0/resources"
    },
    {
      "op": "copy",
      "from": "/context/component/image",
      "path": "/resources/3/spec/template/spec/initContainers/0/image"
    },
    {
