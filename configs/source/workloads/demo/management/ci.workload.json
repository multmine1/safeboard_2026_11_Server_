  "files": {
    "delivery.yml": {
      "name": "Delivery",
      "on": {
        "push": {
          "branches": [
            "main"
          ]
        },
        "workflow_dispatch": {}
      },
      "jobs": {
        "delivery": {
          "runs-on": "ci",
          "env": {
            "IMAGE_REPOSITORY": "${{ vars.IMAGE_REPOSITORY }}",
            "BUNDLE_REPOSITORY": "${{ vars.BUNDLE_REPOSITORY }}",
            "APP_RELEASE": "${{ vars.APP_RELEASE }}",
            "REGISTRY_USERNAME": "${{ secrets.REGISTRY_USERNAME }}",
            "REGISTRY_PASSWORD": "${{ secrets.REGISTRY_PASSWORD }}",
            "COSIGN_PASSWORD": "${{ secrets.COSIGN_PASSWORD }}",
            "BASE_IMAGE": "${{ vars.BASE_IMAGE }}",
            "DEPLOY_VALUES": "${{ vars.DEPLOY_VALUES }}",
            "APP_NAMESPACE": "${{ vars.APP_NAMESPACE }}",
            "DEPLOY_REVISION": "${{ vars.DEPLOY_REVISION }}"
          },
          "steps": [
            {
              "name": "Checkout",
              "with": {
                "fetch-depth": 0,
                "persist-credentials": false
              }
            },
            {
              "name": "Test application behavior",
              "run": "node --test\n"
            },
            {
              "name": "Check source",
              "run": "gitleaks git --redact\ntrivy fs --exit-code 1 --severity HIGH,CRITICAL .\n"
            },
            {
              "name": "Authenticate Registry",
              "run": "printf %s \"$REGISTRY_PASSWORD\" | docker login \"$REGISTRY\" --username \"$REGISTRY_USERNAME\" --password-stdin"
            },
            {
              "name": "Build and publish",
              "run": "docker buildx build --build-arg BASE_IMAGE --network host --allow network.host --metadata-file image.json --tag \"${IMAGE_REPOSITORY:?}:${GITHUB_SHA}-${DEPLOY_REVISION:?}\" --push .\nnode -e 'const fs=require(\"fs\"); const m=JSON.parse(fs.readFileSync(\"image.json\")); fs.appendFileSync(process.env.GITHUB_ENV,\"IMAGE_REF=\"+process.env.IMAGE_REPOSITORY+\"@\"+m[\"containerimage.digest\"]+\"\\n\");'\n"
            },
            {
              "name": "Validate the built application image",
              "run": "node --test tests/image.test.mjs\n"
            },
            {
              "name": "Scan and sign the immutable image",
              "run": "trivy image --exit-code 1 --severity HIGH,CRITICAL \"$IMAGE_REF\"\ncosign sign --key /signing/cosign.key --signing-config /etc/ci/signing-config.json --yes \"$IMAGE_REF\"\ncosign verify --key /signing/cosign.pub --insecure-ignore-tlog \"$IMAGE_REF\"\n"
            },
            {
              "name": "Publish and deploy the Helm bundle",
              "run": "printf %s \"${DEPLOY_VALUES:?}\" > .ci-values.json\nwerf bundle publish --repo \"${BUNDLE_REPOSITORY:?}\" --tag \"${GITHUB_SHA}-${DEPLOY_REVISION:?}\" --values .ci-values.json --set-string image.ref=\"$IMAGE_REF\"\nwerf bundle apply --repo \"$BUNDLE_REPOSITORY\" --tag \"${GITHUB_SHA}-${DEPLOY_REVISION:?}\" --namespace \"${APP_NAMESPACE:?}\" --release \"${APP_RELEASE:?}\"\n"
            },
            {
              "name": "Publish a selected portfolio mirror",
              "if": "${{ vars.PUBLISH_PORTFOLIO == 'true' }}",
              "env": {
                "PORTFOLIO_SOURCE_URL": "${{ secrets.PORTFOLIO_SOURCE_URL }}",
                "PORTFOLIO_PUSH_URL": "${{ secrets.PORTFOLIO_PUSH_URL }}"
              },
              "run": "git clone --mirror \"$PORTFOLIO_SOURCE_URL\" mirror.git\ncd mirror.git\ngit push --mirror \"$PORTFOLIO_PUSH_URL\"\n"
            },
            {
              "name": "Close Registry credentials",
              "if": "always()",
              "run": "docker logout \"$REGISTRY\"\nrm -rf mirror.git\n"
            }
          ]
        }
      }
    },
    "runner.json": {
      "log": {
        "level": "info"
      },
      "runner": {
        "capacity": 1,
        "timeout": "2h",
        "labels": [
          "ci:host"
        ],
        "envs": {
          "KUBECONFIG": "/etc/ci/kubeconfig.json",
          "GIT_SSL_CAINFO": "/etc/ssl/certs/ca-certificates.crt",
          "WERF_SYNCHRONIZATION": ":local",
          "NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/ca-certificates.crt"
        }
      },
      "host": {
        "workdir_parent": "/workspace"
      },
      "cache": {
        "enabled": false
      }
    }
  },
  "compute": {
    "main": {
      "containers": {
        "main": {
          "requests": {
            "cpu_millicores": 100,
            "ram_mib": 256
          },
          "limits": {
            "cpu_millicores": 3000,
            "ram_mib": 4096
          }
        }
      },
      "replicas": 1
    }
  }
}
