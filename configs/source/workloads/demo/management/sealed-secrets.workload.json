{
  "name": "sealed-secrets",
  "vm": "fa226c98-5672-5491-99c1-1442558cf103",
  "enabled": true,
  "component": "sealed-secrets",
  "chart": {
    "values": {}
  },
  "patches": [
    {
      "op": "copy",
      "from": "/context/name",
      "path": "/chart/values/fullnameOverride"
    },
    {
      "op": "copy",
      "from": "/context/node_selector",
      "path": "/chart/values/nodeSelector"
    },
    {
      "op": "copy",
      "from": "/context/pod_labels",
      "path": "/chart/values/podLabels"
    },
    {
      "op": "copy",
      "from": "/context/revision_annotations",
      "path": "/chart/values/podAnnotations"
    },
    {
      "op": "copy",
      "from": "/context/compute/main/containers/main",
      "path": "/chart/values/resources"
    }
  ],
  "readiness": [
    {
      "resource": "deployment/sealed-secrets",
      "rollout": true,
      "revision_path": "{.spec.template.metadata.annotations.skeleton\\.config-hash}"
    }
  ],
  "compute": {
    "main": {
      "containers": {
        "main": {
          "requests": {
            "cpu_millicores": 50,
            "ram_mib": 64
          },
          "limits": {
            "cpu_millicores": 250,
            "ram_mib": 256
          }
        }
      }
    }
  }
}
