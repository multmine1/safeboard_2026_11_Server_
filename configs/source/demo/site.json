    "ssh": {
      "gateway": "hypervisor",
      "port": 22,
      "unit": "ssh",
      "config_path": "/etc/ssh/sshd_config.d/60-infrastructure.conf",
      "bootstrap_user": "root",
      "admin_user": "admin",
      "bootstrap_options": {
        "PasswordAuthentication": "no",
        "KbdInteractiveAuthentication": "no",
        "PubkeyAuthentication": "yes",
        "PermitRootLogin": "prohibit-password"
      },
      "admin_options": {
        "PasswordAuthentication": "no",
        "KbdInteractiveAuthentication": "no",
        "PubkeyAuthentication": "yes",
        "PermitRootLogin": "no"
      },
      "client_args": "-o IdentityAgent=SSH_AUTH_SOCK -o StrictHostKeyChecking=accept-new",
      "admin_settings": {
        "groups": [
          "sudo"
        ],
        "shell": "/bin/bash"
      },
      "transport": "ssh"
