        }
      }
    },
    "pool": {
      "type": "dir",
      "create": {
        "build": true,
        "start": true,
        "autostart": true
      }
    },
    "seed_disk": {
      "device": "cdrom",
      "driver": {
        "name": "qemu",
        "type": "raw"
      },
      "target": {
        "dev": "sda",
        "bus": "sata"
      },
      "read_only": true
