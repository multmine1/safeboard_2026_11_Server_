      "capture": {
        "guest_directory": "/var/tmp",
        "local_directory": "environment/.tools/backup-capture",
        "reserve_mib": 2048
      },
      "host": {
        "name": "skeleton-data-backup",
        "binary": "/usr/local/bin/restic",
        "unit_directory": "/etc/systemd/system",
        "capture_directory": "/var/cache/skeleton-backup-capture",
        "cache_directory": "/var/cache/skeleton-backup-restic",
        "installation_directory": "/var/cache/skeleton-backup-installation",
        "credential_directory": "/etc/skeleton-backup/credentials",
        "known_hosts": "/etc/skeleton-backup/known_hosts",
        "host_key_file": "/etc/ssh/ssh_host_ed25519_key.pub",
        "tmpfiles_path": "/etc/tmpfiles.d/skeleton-maintenance.conf",
        "credential_key": "host",
        "service_options": {
          "TimeoutStartSec": 3600,
          "UMask": "0077",
          "MemoryMax": "512M"
        },
        "ssh_options": {
          "BatchMode": "yes",
          "StrictHostKeyChecking": "yes",
          "IdentitiesOnly": "yes",
          "IdentityAgent": "none",
          "ConnectTimeout": 15
        },
        "timer": {
          "Timer": {
            "OnCalendar": "daily",
            "Persistent": true,
            "RandomizedDelaySec": 300
          },
          "Install": {
            "WantedBy": "timers.target"
          }
        },
        "nfs": {
          "directory": "/var/cache/skeleton-backup-nfs",
          "options": "ro,nosuid,nodev,noexec,vers=4.2,proto=tcp,soft,timeo=50,retrans=2,retry=0"
        },
        "account": {
          "shell": "/usr/sbin/nologin",
          "file_mode": "0440",
          "directory_mode": "2770"
        }
      },
      "filesystem_watchdog": {
        "OnActiveSec": 300,
        "AccuracySec": 1
      }
    }
