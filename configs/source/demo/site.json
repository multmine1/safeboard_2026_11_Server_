          "name": "nextcloud-files",
          "kind": "nfs",
          "workload": "nfs-public",
          "export": "nextcloud"
        },
        {
          "name": "mail-files",
          "kind": "nfs",
          "workload": "stalwart",
          "export": "messages"
        }
