{
  "pod_prefix": 26,
  "asn_pool": {
    "first": 64512,
    "last": 65534
  },
  "pod_nat_outgoing": true,
  "bgp": {
    "port": 179,
    "sourceAddress": "None",
    "nextHopMode": "Self"
  },
  "ports": {
    "kubelet": 10250
  },
  "config": {
    "apiVersion": "k0s.k0sproject.io/v1beta1",
    "kind": "ClusterConfig",
    "metadata": {
      "name": "test"
    },
    "spec": {
      "api": {
        "port": 6443
      },
      "network": {
        "provider": "calico",
        "podCIDR": "10.244.0.0/16",
        "serviceCIDR": "10.96.0.0/12",
        "clusterDomain": "cluster.local",
        "calico": {
          "mode": "bird",
          "overlay": "Never",
          "ipAutodetectionMethod": "kubernetes-internal-ip",
          "envVars": {
            "NO_DEFAULT_POOLS": "true",
            "CALICO_IPV4POOL_CIDR": ""
          }
        }
      },
      "images": {
        "calico": {
          "cni": {
            "image": "quay.io/k0sproject/calico-cni",
            "version": "v3.32.2-1"
          },
          "node": {
            "image": "quay.io/k0sproject/calico-node",
            "version": "v3.32.2-1"
          },
          "kubecontrollers": {
            "image": "quay.io/k0sproject/calico-kube-controllers",
            "version": "v3.32.2-1"
          }
        }
      }
    }
  },
  "router_taint": {
    "key": "skeleton.router",
    "value": "true",
    "effect": "NoSchedule"
  },
  "paths": {
    "binary": "/usr/local/bin/k0s",
    "config": "/etc/k0s/k0s.json",
    "join_token": "/etc/k0s/worker.token",
    "unit_directory": "/etc/systemd/system",
    "install_record": "/etc/k0s/install.json",
    "manifest_directory": "/var/lib/k0s/manifests"
  },
  "controller_args": [
    "--enable-worker",
    "--no-taints",
    "--disable-components=coredns,konnectivity-server"
  ],
  "worker_args": [],
  "services": {
    "controller": "k0scontroller",
    "worker": "k0sworker"
  },
  "pod_interface_glob": "cali*",
  "ipam": {
    "strictAffinity": true,
    "maxBlocksPerHost": 1,
    "autoAllocateBlocks": true
  },
  "kubelet": {
    "maxPods": 32
  },
  "router_runtime": {
    "init_image": "docker.io/library/debian@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d",
    "dns_image": "docker.io/coredns/coredns@sha256:3429e3bbffb1e839470c4a3541d4d78aca84a1394c75a539d0200c58c63196ac",
    "pull_policy": "IfNotPresent",
    "namespace": "skeleton-routers",
    "service_account": "router-dns",
    "namespace_labels": {
      "pod-security.kubernetes.io/enforce": "privileged"
    },
    "state_directory": "/var/lib/skeleton/router",
    "apply_playbook": "/var/lib/skeleton/router/apply.yml",
    "payload_mount": "/payload",
    "state_mount": "/host-state",
    "shared_namespaces": [
      "default"
    ],
    "health_port": 8080,
    "ready_port": 8181,
    "probe_settings": {
      "periodSeconds": 3,
      "timeoutSeconds": 2,
      "failureThreshold": 10
    },
    "resources": {
      "requests": {
        "cpu": "100m",
        "memory": "64Mi"
      },
      "limits": {
        "cpu": "500m",
        "memory": "128Mi"
      }
    },
    "init_resources": {
      "requests": {
        "cpu": "100m",
        "memory": "256Mi"
      },
      "limits": {
        "cpu": "1",
        "memory": "768Mi"
      }
    },
    "init_security": {
      "privileged": true,
      "runAsUser": 0
    },
    "dns_security": {
      "runAsUser": 65532,
      "runAsGroup": 65532,
      "allowPrivilegeEscalation": false,
      "readOnlyRootFilesystem": true,
      "capabilities": {
        "drop": [
          "ALL"
        ],
        "add": [
          "NET_BIND_SERVICE"
        ]
      }
    },
    "copy_security": {
      "runAsUser": 0,
      "allowPrivilegeEscalation": false,
      "capabilities": {
        "drop": [
          "ALL"
        ]
      }
    }
  },
  "deployment": {
    "stack_prefix": "skeleton",
    "directory_mode": "0755",
    "file_mode": "0644",
    "private_file_mode": "0600",
    "binary_mode": "0755",
    "readiness_timeout": "180s",
    "api_retries": 90,
    "api_delay": 2,
    "token_expiry": "10m",
    "system_rollouts": [
      {
        "namespace": "kube-system",
        "resource": "daemonset/calico-node",
        "pod_selector": "k8s-app=calico-node",
        "node_roles": ["controller", "worker", "router"]
      },
      {
        "namespace": "kube-system",
        "resource": "deployment/calico-kube-controllers"
      },
      {
        "namespace": "kube-system",
        "resource": "deployment/metrics-server"
      }
    ],
    "retired_stack_directories": [
      "/var/lib/k0s/manifests/konnectivity"
    ]
  }
}
